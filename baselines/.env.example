# 复制为 baselines/.env 后填写。该文件已在 .gitignore 中，不会入库。
# 只读 baselines/.cache_live/ 重跑（命中缓存）时可不填 key。

# OpenAI 兼容端点与密钥
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 实验口径：全量基线用的是 deepseek-flash（缓存 key 含模型名，换模型会重新计费）
SCHEMA_CHANGE_LLM_MODEL=deepseek-flash

# 可选：思考强度与超时
SCHEMA_CHANGE_REASONING_EFFORT=high
SCHEMA_CHANGE_LLM_TIMEOUT=180
